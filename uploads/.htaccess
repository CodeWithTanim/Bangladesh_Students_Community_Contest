# Secure Uploads Directory Configuration

# Disable script execution engines if supported
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Block access to server-side script extensions completely
<FilesMatch "\.(php|php[0-9]|phtml|pl|py|jsp|asp|html|htm|shtml|sh|cgi|exe|htaccess)$">
    ForceType text/plain
    Header set Content-Disposition "attachment"
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory indexing/browsing
Options -Indexes

# Override order and allow only PDF file serving
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
</IfModule>

<FilesMatch "\.(pdf|PDF)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>
